{
  "compilerOptions": {
    // File Layout
    "outDir": "./dist",
    "rootDir": ".",

    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Recommended Options
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
  "include": [
    "app/**/*.ts",
    "config/**/*.ts",
    "shared/**/*.ts",
    "modules/**/*.ts",
    "docs/api/**/*.ts",
    "prisma.config.ts",
  ],
  "exclude": ["node_modules", "dist", "app/generated"]
}
