# App
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# S3 Bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_URL_TTL_SECONDS=900
