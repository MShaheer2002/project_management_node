# Database — PostgreSQL connection string
DATABASE_URL="postgresql://shaheer:root@localhost:5432/project_management_dev"

# Clerk — Authentication provider (get from https://dashboard.clerk.com)
CLERK_PUBLISHABLE_KEY=pk_test_
CLERK_SECRET_KEY=sk_test_
CLERK_WEBHOOK_SECRET=

# Resend — Email service (get from https://resend.com/api-keys)
RESEND_API_KEY=re_

# App
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# S3 Bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_URL_TTL_SECONDS=900
AWS_S3_UPLOAD_PREFIX=uploads
AWS_S3_PUBLIC_BASE_URL=
UPLOAD_IMAGE_MAX_BYTES=5242880
UPLOAD_VIDEO_MAX_BYTES=52428800

#Github
GITHUB_CLIENT_ID=your_client_id_here                                                                                     
GITHUB_CLIENT_SECRET=your_client_secret_here                                                                           
GITHUB_WEBHOOK_SECRET=any_random_string_here 

#Slack
SLACK_CLIENT_ID=your_client_id 
SLACK_CLIENT_SECRET=your_client_secret
SLACK_SIGNING_SECRET=your_signing_secret
SLACK_BOT_TOKEN=your_bot_token

# Google
  GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
  GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
  GOOGLE_REDIRECT_URI=http://localhost:8000/me/drive/callback
  ENCRYPTION_KEY=a-random-32-char-string-for-token-encryption

# OpenRouter — AI gateway (Phase 20)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# AI Models — Issue Creator (Phase 20A)
AI_ISSUE_MODEL_DEFAULT=deepseek/deepseek-v4-flash
AI_ISSUE_MODEL_FALLBACK_1=meta-llama/llama-3.3-70b-instruct:free
AI_ISSUE_MODEL_FALLBACK_2=qwen/qwen3-coder:free
AI_ISSUE_MODEL_FALLBACK_3=google/gemma-4-31b-it:free

# AI Models — Trussen AI Chat (Phase 20B)
AI_CHAT_MODEL_DEFAULT=deepseek/deepseek-v4-flash
AI_CHAT_MODEL_FALLBACK_1=meta-llama/llama-3.3-70b-instruct:free
AI_CHAT_MODEL_FALLBACK_2=qwen/qwen3-coder:free
AI_CHAT_MODEL_FALLBACK_3=google/gemma-4-31b-it:free

# Background AI Infrastructure (Phase 20D)
REDIS_URL=redis://127.0.0.1:6379
REDIS_QUEUE_PREFIX=trussen
AI_BACKGROUND_WORKERS_ENABLED=true
AI_BACKGROUND_SCHEDULER_ENABLED=false
AI_EMBEDDING_MODEL=text-embedding-3-small
AI_STALE_ISSUE_DAYS=7
AI_BACKGROUND_ASSIGNEE_CANDIDATE_LIMIT=3
# Jobs in parallel per queue, for the 5 non-embeddings queues (issue-intelligence,
# stale-scan, weekly-digest, sprint-planning, proactive-summary)
AI_WORKER_CONCURRENCY=2
# Embeddings call a rate-limited external API, so it's tuned separately
AI_EMBEDDINGS_WORKER_CONCURRENCY=2
AI_EMBEDDINGS_RATE_LIMIT_MAX=10
AI_EMBEDDINGS_RATE_LIMIT_DURATION_MS=1000
# HTTP liveness endpoint for the worker process (GET /health). 0 disables it.
AI_WORKER_HEALTH_PORT=9201
# Coalesces a burst of writes to the same project/team/cycle into one
# proactive-summary job instead of one per write.
AI_PROACTIVE_SUMMARY_DEBOUNCE_MS=30000
# Bull Board queue dashboard — off by default, exposes job data across every
# workspace. Requires BULL_BOARD_USERNAME/PASSWORD to actually start.
BULL_BOARD_ENABLED=false
BULL_BOARD_PORT=9202
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=
