// ============================================================================
// Trussen — Prisma Schema
// A SaaS project management platform (Linear clone)
//
// Auth: Clerk (external) — our User table syncs via webhooks
// DB: PostgreSQL
// Multi-tenancy: All workspace-scoped entities have a workspaceId FK
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

/// Workspace membership roles — hierarchical: OWNER > ADMIN > MEMBER > GUEST
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

/// Controls who can see a department, project, or other scoped entity
enum Visibility {
  PUBLIC
  PRIVATE
}

/// The three types of work items in the system
/// TASK = general work, BUG = defect, ISSUE = feature request/enhancement
enum IssueType {
  TASK
  BUG
  ISSUE
}

/// Kanban workflow statuses — issues move left to right
/// BACKLOG → TODO → IN_PROGRESS → REVIEW → DONE
enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

/// Issue urgency level — used for sorting and filtering
enum IssuePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Bug-specific severity — only relevant when IssueType = BUG
enum BugSeverity {
  LOW
  MEDIUM
  HIGH
}

/// Project lifecycle status
enum ProjectStatus {
  ACTIVE
  ARCHIVED
  COMPLETED
}

/// Role of a member inside a project scope
enum ProjectMembershipRole {
  LEAD
  MEMBER
}

/// Milestone progress inside a project roadmap
enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  MISSED
}

/// Lifecycle of a project-to-project roadmap dependency
enum ProjectDependencyStatus {
  ACTIVE
  RESOLVED
  CANCELLED
}

/// Sprint/cycle lifecycle — auto-transitions based on dates
enum CycleStatus {
  UPCOMING
  CURRENT
  COMPLETED
}

/// What triggered a notification for a user
enum NotificationType {
  MENTION
  ASSIGNMENT
  UPDATE
  COMMENT_REPLY
  PROJECT_MEMBER
  TEAM_MEMBER
  WORKSPACE_INVITE
  ISSUE_DUE_SOON
  ISSUE_OVERDUE
}

/// Categories of trackable actions in the activity feed
enum ActivityType {
  ISSUE_CREATED
  ISSUE_COMPLETED
  COMMENT_ADDED
  MEMBER_JOINED
  STATUS_CHANGED
  ASSIGNMENT_CHANGED
  LABEL_CREATED
  LABEL_UPDATED
  LABEL_DELETED
  ISSUE_LABEL_ADDED
  ISSUE_LABEL_REMOVED
  ISSUE_TYPE_CHANGED
  ISSUE_STATUS_CHANGED
  ISSUE_PRIORITY_CHANGED
  ISSUE_ASSIGNEE_CHANGED
  ISSUE_DUE_DATE_CHANGED
  ISSUE_SCOPE_CHANGED
  ISSUE_ARCHIVED
  COMMENT_CREATED
  COMMENT_EDITED
  COMMENT_DELETED
  COMMENT_MENTIONED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED
  TEAM_MEMBER_JOINED
  TEAM_MEMBER_REMOVED
  TEAM_MEMBER_ROLE_CHANGED
  WORKSPACE_MEMBER_JOINED
  WORKSPACE_MEMBER_REMOVED
  CYCLE_CREATED
  CYCLE_UPDATED
  CYCLE_DATES_CHANGED
  CYCLE_GOAL_CHANGED
  CYCLE_STARTED
  CYCLE_COMPLETED
  CYCLE_REOPENED
  CYCLE_DELETED
  ISSUE_CYCLE_CHANGED
  ISSUE_ADDED_TO_CYCLE
  ISSUE_REMOVED_FROM_CYCLE
  CYCLE_ISSUE_STATUS_CHANGED
  CYCLE_ISSUE_PRIORITY_CHANGED
  CYCLE_ISSUE_ASSIGNEE_CHANGED
  CYCLE_ISSUE_COMMENT_CREATED
  CYCLE_CARRY_OVER
  TEMPLATE_CREATED
  TEMPLATE_UPDATED
  TEMPLATE_DELETED
  TEMPLATE_ACTIVATED
  TEMPLATE_DEACTIVATED
  TEMPLATE_APPLIED
  ROADMAP_SCHEDULE_UPDATED
  ROADMAP_MILESTONE_CREATED
  ROADMAP_MILESTONE_UPDATED
  ROADMAP_MILESTONE_COMPLETED
  ROADMAP_MILESTONE_DELETED
  ROADMAP_MILESTONES_REORDERED
