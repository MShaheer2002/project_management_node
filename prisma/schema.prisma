  INTEGRATION_DISCONNECTED
  GITHUB_COMMIT_LINKED
  GITHUB_BRANCH_LINKED
  GITHUB_PR_OPENED
  GITHUB_PR_MERGED
  GITHUB_PR_CLOSED
  GITHUB_PR_REVIEW
  DRIVE_CONNECTED
  DRIVE_DISCONNECTED
