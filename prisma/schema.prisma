/// What kind of entity an activity log entry refers to
enum ActivityTargetType {
  ISSUE
  PROJECT
  TEAM
  DEPARTMENT
  WORKSPACE
  COMMENT
  LABEL
  MEMBER
  CYCLE
  TEMPLATE
  DOCUMENT
  INTEGRATION
}

/// How two issues are related to each other
enum IssueRelationType {
  RELATED
  BLOCKS
  BLOCKED_BY
  DUPLICATE
}

/// Subscription tiers — Free (default), Standard ($6/user/mo), Premium ($10/user/mo)
enum SubscriptionPlan {
  FREE
  STANDARD
  PREMIUM
}

/// Stripe subscription lifecycle states
enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
  UNPAID
}

/// How often the workspace is billed
enum BillingCycle {
  MONTHLY
  ANNUAL
}

/// Invoice payment state
enum InvoiceStatus {
  PAID
  UNPAID
  VOID
}

/// Supported payment types for billing
enum PaymentMethodType {
  CARD
  BANK_TRANSFER
}

/// Team size range — selected during workspace onboarding
/// Used for plan recommendations, onboarding flow, and analytics
enum TeamSize {
  SMALL       // 1-5 members
  MEDIUM      // 6-20 members
  LARGE       // 21-50 members
  ENTERPRISE  // 50+ members
}

/// Invitation lifecycle — tracks the state of a workspace invite
enum InvitationStatus {
  PENDING   // Invite sent, waiting for acceptance
  ACCEPTED  // Invitee accepted and joined the workspace
  EXPIRED   // Invite passed its expiry date without being accepted
  REVOKED   // Admin manually cancelled the invite
}

/// Where workspace members are allowed to upload file attachments
/// BOTH = system storage (S3) + Google Drive (default)
/// SYSTEM_ONLY = S3 only, Drive button hidden
/// DRIVE_ONLY = Google Drive only, S3 button hidden (members must connect Drive)
enum UploadPolicy {
  BOTH
  SYSTEM_ONLY
  DRIVE_ONLY
}

/// Third-party services that can be connected to a workspace
enum IntegrationProvider {
  GITHUB
  SLACK
  DISCORD
  FIGMA
}

/// Where a document belongs in the product model
enum DocumentScope {
  WORKSPACE
  TEAM
  PROJECT
}

enum AiConnectionClient {
  CODEX
  CLAUDE_DESKTOP
  CURSOR
  GENERIC_MCP
}

enum AiConnectionAuthType {
  PAT
}

enum AiConnectionStatus {
  ACTIVE
  REVOKED
}

enum AiConnectionVerificationStatus {
  READY
  WARNING
  ERROR
}

enum AiConnectionSessionStatus {
  ACTIVE
  SUCCEEDED
  FAILED
  REJECTED
}

// ============================================================================
// CORE IDENTITY
// ============================================================================

/// User — synced from Clerk via webhooks (user.created / user.updated / user.deleted)
///
/// Clerk is the source of truth for auth (passwords, OAuth, 2FA, sessions).
/// We only store profile data needed for relations and display.
/// The `id` field IS the Clerk user_id (e.g., "user_2x..."), NOT a UUID.
model User {
  id           String    @id // Clerk user_id — set by webhook, not auto-generated
  email        String    @unique
  name         String
  avatar       String?
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // -- Membership relations (User ↔ Workspace/Team/Department) --
  workspaceMemberships  WorkspaceMembership[]
  teamMemberships       TeamMembership[]
  departmentMemberships DepartmentMembership[]
  projectMemberships    ProjectMembership[]
  issueWatchers         IssueWatcher[]

  // -- Ownership/lead relations --
  createdWorkspaces     Workspace[]    @relation("WorkspaceCreator") // Workspaces this user created
  ledTeams              Team[]         @relation("TeamLead") // Teams where this user is the lead
  headedDepartments     Department[]   @relation("DepartmentHead") // Departments where this user is head
  ledProjects           Project[]      @relation("ProjectLead") // Projects where this user is lead

  // -- Issue relations --
  assignedIssues Issue[] @relation("IssueAssignee") // Issues assigned to this user
  createdIssues  Issue[] @relation("IssueCreator") // Issues created by this user

  // -- Collaboration --
  comments Comment[]

  // -- Notifications (recipient vs actor) --
  notifications      Notification[] @relation("NotificationRecipient") // Notifications FOR this user
  actedNotifications Notification[] @relation("NotificationActor") // Notifications triggered BY this user

  // -- Invitations --
  sentInvitations WorkspaceInvitation[] @relation("InvitationSender") // Invites this user sent

  // -- Other --
  activities            Activity[] // Activity log entries by this user
  createdTemplates      Template[] @relation("TemplateCreator") // Templates created by this user
  updatedTemplates      Template[] @relation("TemplateUpdater") // Templates last updated by this user
  templateApplications  TemplateApplication[] // Template apply sessions for this user
  ownedProjectMilestones ProjectMilestone[] @relation("RoadmapMilestoneOwner")
  createdProjectMilestones ProjectMilestone[] @relation("RoadmapMilestoneCreator")
  completedProjectMilestones ProjectMilestone[] @relation("RoadmapMilestoneCompleter")
  createdProjectDependencies ProjectDependency[] @relation("RoadmapDependencyCreator")
  resolvedProjectDependencies ProjectDependency[] @relation("RoadmapDependencyResolver")
  cancelledProjectDependencies ProjectDependency[] @relation("RoadmapDependencyCanceller")
  createdApiKeys        ApiKey[] // API keys created by this user
  connectedIntegrations Integration[] // Integrations connected by this user
  aiConnections        AiConnection[] // External AI client connections owned by this user
  aiConnectionSessions AiConnectionSession[]
  createdIssueAttachments IssueAttachment[]
  createdCommentAttachments CommentAttachment[]
  uploadedDocuments     EntityDocument[] @relation("EntityDocumentUploader")
  createdDocumentFolders DocumentFolder[] @relation("DocumentFolderCreator")
  driveConnection       UserDriveConnection? // Per-user Google Drive OAuth connection
  aiConversations       AiConversation[] // Trussen AI chat conversations
  aiUserUsageDaily      AiUserUsageDaily[] // Daily AI usage rollups per workspace
  aiToolExecutions      AiToolExecution[] // Recent AI mutation executions for duplicate protection
  aiResolverSnapshots   AiResolverSnapshot[] // Entity-resolution audit snapshots
  createdAiSuggestions  AiSuggestion[] @relation("AiSuggestionCreatedBy")
  acceptedAiSuggestions AiSuggestion[] @relation("AiSuggestionAcceptedBy")
  dismissedAiSuggestions AiSuggestion[] @relation("AiSuggestionDismissedBy")

  @@index([email])
}

// ============================================================================
// WORKSPACE & MULTI-TENANCY
// ============================================================================

/// Workspace — the top-level tenant boundary
///
/// ALL data is scoped to a workspace. One user can belong to multiple workspaces.
/// The `slug` is globally unique and used in URLs: <slug>.trussen.app
/// The `issuePrefix` is a unique uppercase identifier for issue IDs (e.g., "VAT" → VAT-1, VAT-2).
/// The `issueCounter` is atomically incremented per workspace to generate issue numbers.
model Workspace {
  id           String @id @default(uuid())
  name         String // Display name (e.g., "Acme Corp")
  slug         String @unique // URL slug (e.g., "acme-corp") — must be globally unique
  logo         String? // URL to workspace logo
  teamSize     TeamSize? // Selected during onboarding (1-5, 6-20, 21-50, 50+)
  issuePrefix  String @unique // Uppercase prefix for issue IDs (e.g., "VAT" → VAT-1, VAT-2)
  issueCounter Int    @default(0) // Atomic counter for human-readable issue IDs per workspace
  customStatuses Json  @default("[{\"key\":\"backlog\",\"label\":\"Backlog\",\"color\":\"#6b7280\",\"order\":0,\"isFinal\":false,\"showOnBoard\":true},{\"key\":\"todo\",\"label\":\"Todo\",\"color\":\"#3b82f6\",\"order\":1,\"isFinal\":false,\"showOnBoard\":true},{\"key\":\"in-progress\",\"label\":\"In Progress\",\"color\":\"#f59e0b\",\"order\":2,\"isFinal\":false,\"showOnBoard\":true},{\"key\":\"review\",\"label\":\"Review\",\"color\":\"#8b5cf6\",\"order\":3,\"isFinal\":false,\"showOnBoard\":true},{\"key\":\"done\",\"label\":\"Done\",\"color\":\"#22c55e\",\"order\":4,\"isFinal\":true,\"showOnBoard\":true}]")
  uploadPolicy UploadPolicy @default(BOTH) // Controls where members can upload: BOTH, SYSTEM_ONLY, DRIVE_ONLY
  createdById  String // FK → User who created this workspace (becomes OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // -- Creator relation --
  createdBy User @relation("WorkspaceCreator", fields: [createdById], references: [id])

  // -- All workspace-scoped entities --
  memberships    WorkspaceMembership[]
  invitations    WorkspaceInvitation[]
  departments    Department[]
  teams          Team[]
  projects       Project[]
  issues         Issue[]
  issueAttachments IssueAttachment[]
  commentAttachments CommentAttachment[]
  documents      EntityDocument[]
  documentFolders DocumentFolder[]
  labels         Label[]
  cycles         Cycle[]
  roadmapMilestones ProjectMilestone[]
  roadmapDependencies ProjectDependency[]
  notifications  Notification[]
  activities     Activity[]
  templates      Template[]
  templateApplications TemplateApplication[]
  integrations   Integration[]
  apiKeys        ApiKey[]
  aiConnections  AiConnection[]
  aiConnectionSessions AiConnectionSession[]
  subscriptions  Subscription[]
  invoices       Invoice[]
  paymentMethods PaymentMethod[]
  billingWebhookEvents BillingWebhookEvent[]
  aiConversations  AiConversation[]
  aiWorkspaceUsageDaily AiWorkspaceUsageDaily[]
  aiUserUsageDaily      AiUserUsageDaily[]
  aiToolExecutions      AiToolExecution[]
  aiSuggestions         AiSuggestion[]
  aiEmbeddings          AiEmbedding[]
  entityAliases         EntityAlias[]
  aiJobRuns             AiJobRun[]
  aiResolverSnapshots   AiResolverSnapshot[]
  aiMetricCountersDaily AiMetricCounterDaily[]

  @@index([slug])
}

/// WorkspaceMembership — join table linking User ↔ Workspace with a role
///
/// Every user in a workspace has exactly one role (OWNER, ADMIN, MEMBER, GUEST).
/// A user + workspace combination must be unique (can't join the same workspace twice).
/// `invitedById` tracks who brought this member in (null for the OWNER who created the workspace).
model WorkspaceMembership {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  designation String?
  invitedById String? // FK → User who invited this member (null for workspace creator)
  joinedAt    DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId]) // A user can only be in a workspace once
  @@index([workspaceId])
  @@index([userId])
}

/// WorkspaceInvitation — tracks pending, accepted, and revoked workspace invitations
///
/// Security design:
///   - Token is HASHED before storage (sha256) — raw token only exists in the email link
///   - Acceptance verifies authenticated_user.email === invitation.email (email-bound, not token-bound)
///   - Prevents forwarded invite abuse (token alone is not enough)
///   - Expired/revoked invites cannot be accepted
///
/// Lifecycle: PENDING → ACCEPTED / EXPIRED / REVOKED
///   - Only one PENDING invite per (workspaceId, email) at a time
///   - Resending an invite = revoke old + create new (clean audit trail)
///   - Accept is idempotent (double-click safe)
///
/// Email is stored LOWERCASED for consistent matching (Jane@Example.com → jane@example.com)
model WorkspaceInvitation {
  id           String           @id @default(uuid())
  workspaceId  String
  email        String // Invitee's email — ALWAYS stored lowercase
  role         WorkspaceRole    @default(MEMBER) // Role assigned on acceptance
  designation  String?
  teamId       String // FK → Team the invitee will be assigned to on acceptance (required)
  departmentId String? // FK → Department the invitee will be assigned to (optional)
  tokenHash    String           @unique // SHA-256 hash of the raw invite token (never store raw)
  status       InvitationStatus @default(PENDING)
  invitedById  String // FK → User who sent the invitation
  expiresAt    DateTime // When this invite expires (default: 7 days from creation)
  acceptedAt   DateTime? // Set when invitee accepts
  revokedAt    DateTime? // Set when admin revokes
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy  User        @relation("InvitationSender", fields: [invitedById], references: [id])
  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, email]) // Fast lookup: "does this email have a pending invite for this workspace?"
  @@index([workspaceId, status]) // List pending/accepted invites for a workspace
  @@index([tokenHash]) // Resolve invite by token hash (unique already indexed, but explicit for clarity)
}

// ============================================================================
// ORGANIZATIONAL STRUCTURE
// ============================================================================

/// Department — an organizational division within a workspace
///
/// Departments group teams. Example: "Engineering", "Design", "Marketing".
/// A department has an optional head (a user with edit permissions for this department).
/// Visibility controls whether GUESTs can see it.
/// If `isDefault = true`, new workspace members auto-join this department.
model Department {
  id          String     @id @default(uuid())
  workspaceId String
  name        String
  description String?
  headId      String? // FK → User who heads this department (contextual permission)
  color       String? // Hex color for UI display
  icon        String? // Icon identifier for UI
  visibility  Visibility @default(PUBLIC)
  isDefault   Boolean    @default(false) // New members auto-join if true
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // -- Relations --
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  head        User?                  @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  teams       Team[] // Teams that belong to this department
  memberships DepartmentMembership[] // Users in this department
  projects    Project[] // Projects under this department (denormalized from team)
  issues      Issue[] // Issues under this department (denormalized from team)
  invitations WorkspaceInvitation[] // Invitations targeting this department

  @@unique([workspaceId, name]) // Department names must be unique within a workspace
  @@index([workspaceId])
  @@index([headId])
  @@index([visibility])
  @@index([isDefault])
}

/// DepartmentMembership — join table linking User ↔ Department
///
/// Uses composite primary key (userId + departmentId) — no separate id field.
model DepartmentMembership {
  userId       String
  departmentId String
  joinedAt     DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId]) // Composite PK — user can only be in a department once
  @@index([departmentId])
}

/// Team — a group of members that owns projects and issues
///
/// Teams optionally belong to a department. Every team has a lead.
/// Team names must be unique within a workspace.
/// If the parent department is deleted, the team remains (departmentId → null).
model Team {
  id           String   @id @default(uuid())
  workspaceId  String
  departmentId String? // Optional — team can exist without a department
  name         String
  description  String?
  leadId       String // FK → User who leads this team (contextual edit permission)
  visibility   Visibility @default(PUBLIC)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // -- Relations --
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department  Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  lead        User             @relation("TeamLead", fields: [leadId], references: [id])
  memberships TeamMembership[] // Users in this team
  projects    Project[] // Projects owned by this team
  issues      Issue[] // Issues under this team
  cycles      Cycle[] // Sprints scoped to this team
  invitations WorkspaceInvitation[] // Invitations targeting this team
  documents   EntityDocument[]
  documentFolders DocumentFolder[]

  @@unique([workspaceId, name]) // Team names must be unique within a workspace
  @@index([workspaceId])
  @@index([departmentId])
  @@index([leadId])
  @@index([visibility])
}

/// TeamMembership — join table linking User ↔ Team
///
/// Uses composite primary key (userId + teamId) — no separate id field.
model TeamMembership {
  userId   String
  teamId   String
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId]) // Composite PK — user can only be in a team once
  @@index([teamId])
}

// ============================================================================
// PROJECTS
// ============================================================================

/// Project — a work container that groups related issues under a team
///
/// Every project belongs to exactly one team and one workspace.
/// `departmentId` is denormalized from the team's department for query performance.
/// Project names must be unique within a workspace.
/// Status: ACTIVE (default) → ARCHIVED or COMPLETED.
model Project {
  id           String        @id @default(uuid())
  workspaceId  String
  teamId       String // FK → Team that owns this project
  departmentId String? // Denormalized from team.departmentId for faster queries
  name         String
  slug         String
  description  String?
  leadId       String? // FK → User who leads this project (contextual edit permission)
  status       ProjectStatus @default(ACTIVE)
  visibility   Visibility    @default(PUBLIC)
  startDate    DateTime?     @db.Date
  targetDate   DateTime?     @db.Date
  featureRoadmap       Boolean @default(true)
  featureCycles        Boolean @default(true)
  featureIssueTracking Boolean @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // -- Relations --
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  lead       User?       @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  memberships ProjectMembership[]
  issues     Issue[] // All issues in this project
  milestones ProjectMilestone[]
  blockingDependencies ProjectDependency[] @relation("RoadmapBlockingProject")
  blockedDependencies ProjectDependency[] @relation("RoadmapBlockedProject")
  documents  EntityDocument[]
  documentFolders DocumentFolder[]

  @@unique([workspaceId, name]) // Project names must be unique within a workspace
  @@unique([workspaceId, slug])
  @@index([workspaceId])
  @@index([teamId])
  @@index([departmentId])
  @@index([status])
}

/// ProjectMembership — links a user to a project and role within that project
model ProjectMembership {
  projectId       String
  userId          String
  membershipRole  ProjectMembershipRole @default(MEMBER)
  joinedAt        DateTime              @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

/// EntityDocument — uploaded document metadata attached to a workspace, team, or project
model DocumentFolder {
  id           String         @id @default(uuid())
  workspaceId  String
  scope        DocumentScope
  teamId       String?
  projectId    String?
  parentId     String?
  name         String
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team       Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     DocumentFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   DocumentFolder[] @relation("FolderTree")
  createdBy  User            @relation("DocumentFolderCreator", fields: [createdById], references: [id], onDelete: Cascade)
  documents  EntityDocument[]

  @@unique([workspaceId, scope, parentId, name])
  @@index([workspaceId, scope, parentId])
  @@index([teamId, parentId])
  @@index([projectId, parentId])
}

model EntityDocument {
  id           String        @id @default(uuid())
  workspaceId  String
  scope        DocumentScope
  teamId       String?
  projectId    String?
  folderId     String?
  name         String
  description  String?
  key          String
  fileName     String
  fileUrl      String?
  mimeType     String
  sizeBytes    Int
  uploadedById String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team       Team?           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project    Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder     DocumentFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy User            @relation("EntityDocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, scope, folderId, createdAt])
  @@index([teamId, folderId, createdAt])
  @@index([projectId, folderId, createdAt])
  @@unique([workspaceId, key])
}

// ============================================================================
// ISSUES — the core product entity
// ============================================================================

/// Issue — the atomic work unit of the system (the "Linear core")
///
/// Issues use a human-readable ID as the primary key (e.g., "LIN-101").
/// The `number` field + `workspaceId` ensures uniqueness within a workspace.
/// `internalId` is a UUID for internal references where the human ID is inconvenient.
///
/// Issue types share one table — type-specific fields are nullable:
///   - BUG fields: stepsToReproduce, expectedBehavior, actualBehavior, severity
///   - ISSUE (feature) fields: acceptanceCriteria, notes
///   - TASK: uses only the common fields
///
/// Kanban flow: BACKLOG → TODO → IN_PROGRESS → REVIEW → DONE (any transition allowed)
model Issue {
  id           String        @id // Human-readable ID: "{prefix}-N" (e.g., "VAT-42") — workspace.issuePrefix + workspace.issueCounter
  internalId   String        @unique @default(uuid()) // UUID for internal use
  number       Int // Sequential number within workspace (used to build the ID)
  workspaceId  String
  projectId    String
  teamId       String
  departmentId String? // Denormalized from team for query performance

  // -- Core fields --
  title       String
  description String?       @db.Text // Rich text (HTML/Markdown)
  type        IssueType     @default(TASK)
  status      String        @default("backlog")
  priority    IssuePriority @default(MEDIUM)
  assigneeId  String? // FK → User assigned to this issue (must be a workspace member)
  creatorId   String // FK → User who created this issue
  dueDate     DateTime?     @db.Date
  dueTime     DateTime?     @db.Time()
  estimate    Int? // Story points / complexity estimate
  cycleId     String? // FK → Cycle (sprint) this issue belongs to
  parentIssueId String? // Optional parent linkage
  integrationRef Json? // Structured external reference payload
  templateId      String? // Optional template source
  templateVersion Int? // Applied template version at creation time
  templateAppliedAt DateTime?

  // -- Bug-specific fields (populated when type = BUG) --
  stepsToReproduce String?     @db.Text
  expectedBehavior String?     @db.Text
  actualBehavior   String?     @db.Text
  severity         BugSeverity?

  // -- Feature/enhancement fields (populated when type = ISSUE) --
  acceptanceCriteria String? @db.Text
  notes              String? @db.Text

  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -- Parent entity relations --
  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignee   User?       @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator    User        @relation("IssueCreator", fields: [creatorId], references: [id])
  cycle      Cycle?      @relation(fields: [cycleId], references: [id], onDelete: SetNull)

  // -- Child entity relations --
  subtasks      IssueSubtask[] // Checklist items within this issue
  comments      Comment[] // Discussion thread on this issue
  labels        IssueLabel[] // Labels attached to this issue (many-to-many)
  relationsFrom IssueRelation[] @relation("IssueRelationFrom") // Relations where this issue is the source
  relationsTo   IssueRelation[] @relation("IssueRelationTo") // Relations where this issue is the target
  parent        Issue?          @relation("IssueParent", fields: [parentIssueId], references: [id], onDelete: SetNull)
  children      Issue[]         @relation("IssueParent")
  watchers      IssueWatcher[]
  attachments   IssueAttachment[]

  @@unique([workspaceId, number]) // Issue numbers are unique within a workspace
  @@index([workspaceId])
  @@index([projectId])
  @@index([teamId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([cycleId])
  @@index([creatorId])
  @@index([workspaceId, status]) // Dashboard: filter issues by status
  @@index([workspaceId, assigneeId]) // "My Issues" page
  @@index([workspaceId, completedAt]) // Analytics: resolution time and completion trends
  @@index([parentIssueId])
  @@index([templateId])
}

/// IssueSubtask — checklist items within an issue
///
/// Subtasks have a drag-and-drop `order` field for reordering.
/// Deleting the parent issue cascades all subtasks.
model IssueSubtask {
  id        String   @id @default(uuid())
  issueId   String
  title     String
  completed Boolean  @default(false)
  order     Int // Sort position for drag-and-drop reordering
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// ============================================================================
// LABELS & ISSUE RELATIONS
// ============================================================================

/// Label — workspace-scoped tags that can be attached to issues
///
/// Labels have a name and color (hex). Names must be unique within a workspace.
/// Many-to-many with Issues via the IssueLabel join table.
model Label {
  id             String @id @default(uuid())
  workspaceId    String
  name           String // e.g., "frontend", "bug", "design"
  normalizedName String // lowercased + trimmed/collapsed spaces for uniqueness
  color          String // Hex color for UI display (e.g., "#ef4444")
  description    String? @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    IssueLabel[] // Issues that have this label

  @@unique([workspaceId, normalizedName]) // Case-insensitive label uniqueness in workspace
  @@index([workspaceId])
  @@index([workspaceId, createdAt])
}

/// IssueLabel — join table for Issue ↔ Label (many-to-many)
///
/// Composite primary key (issueId + labelId) — an issue can't have the same label twice.
model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId]) // Composite PK
  @@index([labelId])
}

/// IssueRelation — tracks dependencies and connections between issues
///
/// Types: RELATED, BLOCKS, BLOCKED_BY, DUPLICATE
/// Creating BLOCKS on A→B should also create BLOCKED_BY on B→A (handled in service layer).
/// An issue cannot be related to itself.
model IssueRelation {
  id        String            @id @default(uuid())
  issueId   String // Source issue
  relatedId String // Target issue
  type      IssueRelationType

  issue   Issue @relation("IssueRelationFrom", fields: [issueId], references: [id], onDelete: Cascade)
  related Issue @relation("IssueRelationTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@unique([issueId, relatedId, type]) // Prevent duplicate relations of same type
  @@index([issueId])
  @@index([relatedId])
}

/// IssueWatcher — users subscribed to issue updates
model IssueWatcher {
  issueId    String
  userId     String
  createdAt  DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([issueId, userId])
  @@index([userId])
}

/// IssueAttachment — persisted uploaded asset references for an issue
model IssueAttachment {
  id          String   @id @default(uuid())
  issueId     String
  workspaceId String
  key         String
  fileName    String
  contentType String
  size        Int
  kind        String // attachment | video
  assetUrl    String?
  createdById String
  createdAt   DateTime @default(now())

  issue      Issue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy  User       @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([issueId, key])
  @@index([issueId])
  @@index([workspaceId])
}

// ============================================================================
// COLLABORATION
// ============================================================================

/// Comment — discussion on an issue, supports threaded replies
///
/// If `parentId` is set, this comment is a reply to another comment.
/// Self-referential relation: Comment → Comment (parent/replies).
/// Deleting a parent comment cascades all its replies.
model Comment {
  id       String @id @default(uuid())
  issueId  String
  authorId String
  body     String @db.Text // Rich text content
  parentId String? // FK → Comment (for threaded replies, null = top-level)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // -- Relations --
  issue   Issue     @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentThread") // Child replies to this comment
  attachments CommentAttachment[]

  @@index([issueId])
  @@index([parentId])
}

/// CommentAttachment — persisted uploaded asset references for a comment
model CommentAttachment {
  id          String   @id @default(uuid())
  commentId   String
  workspaceId String
  key         String
  fileName    String
  contentType String
  size        Int
  kind        String // attachment | video
  assetUrl    String?
  createdById String
  createdAt   DateTime @default(now())

  comment   Comment   @relation(fields: [commentId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([commentId, key])
  @@index([commentId])
  @@index([workspaceId])
}

// ============================================================================
// CYCLES (SPRINTS)
// ============================================================================

/// Cycle — a time-boxed sprint for tracking issue progress
///
/// Cycles have start/end dates and a status that auto-transitions:
///   UPCOMING → CURRENT (when startDate arrives) → COMPLETED (when endDate passes)
/// A cycle can be scoped to a specific team, or be workspace-wide (teamId = null).
/// Issues link to a cycle via Issue.cycleId (one cycle per issue at a time).
model Cycle {
  id          String      @id @default(uuid())
  workspaceId String
  teamId      String
  number      Int
  name        String // e.g., "Sprint 12"
  description String?
  goal        String?
  startsAt    DateTime
  endsAt      DateTime
  status      CycleStatus @default(UPCOMING)
  completedAt DateTime?
  completedById String?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // -- Relations --
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  issues    Issue[] // Issues in this cycle

  @@unique([teamId, number])
  @@index([workspaceId, teamId, status])
  @@index([workspaceId, startsAt, endsAt])
}

// ============================================================================
// ROADMAP
// ============================================================================

/// ProjectMilestone — dated checkpoint on a project roadmap
model ProjectMilestone {
  id            String          @id @default(uuid())
  workspaceId    String
  projectId      String
  name           String
  description    String?        @db.Text
  dueDate        DateTime
  ownerId        String?
  status         MilestoneStatus @default(PLANNED)
  completedAt    DateTime?
  completedById  String?
  sortOrder      Int            @default(0)
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner       User?     @relation("RoadmapMilestoneOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  completedBy User?     @relation("RoadmapMilestoneCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  createdBy   User      @relation("RoadmapMilestoneCreator", fields: [createdById], references: [id])

  @@index([workspaceId, projectId, dueDate])
  @@index([workspaceId, status, dueDate])
  @@index([ownerId])
}

/// ProjectDependency — project-to-project blocking relationship on the roadmap
model ProjectDependency {
  id                String                  @id @default(uuid())
  workspaceId       String
  blockingProjectId String
  blockedProjectId  String
  status            ProjectDependencyStatus @default(ACTIVE)
  note              String?                 @db.Text
  resolvedAt        DateTime?
  resolvedById      String?
  cancelledAt       DateTime?
  cancelledById     String?
  createdById       String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  blockingProject Project   @relation("RoadmapBlockingProject", fields: [blockingProjectId], references: [id], onDelete: Cascade)
  blockedProject  Project   @relation("RoadmapBlockedProject", fields: [blockedProjectId], references: [id], onDelete: Cascade)
  createdBy       User      @relation("RoadmapDependencyCreator", fields: [createdById], references: [id])
  resolvedBy      User?     @relation("RoadmapDependencyResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  cancelledBy     User?     @relation("RoadmapDependencyCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@unique([blockingProjectId, blockedProjectId])
  @@index([workspaceId, blockingProjectId, status])
  @@index([workspaceId, blockedProjectId, status])
}

// ============================================================================
// ACTIVITY & NOTIFICATIONS
// ============================================================================

/// Notification — alerts for users about workspace events
///
/// Types: MENTION (@mentioned in comment), ASSIGNMENT (issue assigned), UPDATE (watched issue changed).
/// Two user relations: `userId` = who receives it, `actorId` = who triggered it.
model Notification {
  id              String           @id @default(uuid())
  workspaceId     String
  recipientUserId String // FK → User who receives this notification
  actorUserId     String? // FK → User who triggered this notification (nullable for system events)
  type            NotificationType
  category        String
  title           String
  message         String
  targetType      String
  targetId        String
  targetPublicId  String?
  targetUrl       String
  metadata        Json?
  readAt          DateTime?
  eventId         String?
  dedupeKey       String?
  createdAt       DateTime         @default(now())

  // -- Relations --
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, recipientUserId, createdAt(sort: Desc)])
  @@index([workspaceId, recipientUserId, readAt, createdAt(sort: Desc)])
  @@index([workspaceId, recipientUserId, type, createdAt(sort: Desc)])
  @@unique([workspaceId, recipientUserId, dedupeKey])
  @@index([workspaceId])
}

/// Activity — immutable audit log of all workspace actions
///
/// Every significant action (issue created, status changed, comment added, etc.)
/// creates an Activity entry. Used for the activity feed and audit trail.
/// `metadata` stores extra context as JSON (e.g., { oldStatus: "TODO", newStatus: "DONE" }).
model Activity {
  id          String             @id @default(uuid())
  workspaceId String
  actorId     String // FK → User who performed the action
  type        ActivityType
  targetId    String // ID of the affected entity (issue ID, project ID, etc.)
  targetType  ActivityTargetType // What kind of entity was affected
  description String // Human-readable summary
  metadata    Json? // Extra context (old/new values, etc.)
  createdAt   DateTime           @default(now())

  // -- Relations --
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User      @relation(fields: [actorId], references: [id])

  @@index([workspaceId])
  @@index([workspaceId, targetType]) // Filter activity by entity type
  @@index([actorId])
  @@index([createdAt]) // Sort activity feed chronologically
}

// ============================================================================
// TEMPLATES
// ============================================================================

/// Template — reusable issue templates for common work items
///
/// Templates pre-fill issue fields (priority, assignee, labels, subtasks).
/// `defaultLabels` is an array of label IDs. `checklistItems` is JSON subtask titles.
/// Template names must be unique within a workspace.
/// Available on Standard and Plus plans only.
model Template {
  id              String         @id @default(uuid())
  workspaceId     String
  name            String
  description     String
  issueType       String // task | bug | issue
  scopeType       String         @default("WORKSPACE") // WORKSPACE | TEAM | PROJECT
  scopeId         String?
  isDefault       Boolean        @default(false)
  category        String
  customCategory  String?
  titleTemplate   String
  contentTemplate String         @db.Text
  defaultPriority String
  defaultStatus   String
  customStatus    String?
  defaultAssigneeType String // UNASSIGNED | CREATOR | SPECIFIC_USER
  defaultAssigneeId String?
  defaultEstimate Int?
  defaultDueDateOffset Int?
  defaultLabelIds String[]
  defaultSeverity String? // low | medium | high
  categoryOptions String[]
  priorityOptions String[]
  statusOptions   String[]
  labelOptions    String[]
  checklistItems  String[]
  stepsToReproduceTemplate String? @db.Text
  expectedBehaviorTemplate String? @db.Text
  actualBehaviorTemplate String? @db.Text
  acceptanceCriteriaTemplate String? @db.Text
  relatedIssueKeysTemplate String? @db.Text
  notesTemplate String? @db.Text
  lifecycle       String @default("ACTIVE")
  isActive        Boolean @default(false)
  activeVersion   Int @default(1)
  usageCount      Int @default(0)
  timesApplied    Int @default(0)
  lastAppliedAt   DateTime?
  deletedAt       DateTime?
  createdById     String
  updatedById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // -- Relations --
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("TemplateCreator", fields: [createdById], references: [id])
  updatedBy User?     @relation("TemplateUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  applications TemplateApplication[]

  @@unique([workspaceId, name])
  @@index([workspaceId, issueType])
  @@index([workspaceId, scopeType, scopeId])
  @@index([workspaceId, isActive])
  @@index([workspaceId, lifecycle])
}

/// TemplateApplication — persisted per-user template apply state and draft snapshot.
///
/// This does not mutate the template itself. It stores the user's last applied draft
/// so the frontend can restore state when navigating away and back.
model TemplateApplication {
  id          String   @id @default(uuid())
  workspaceId String
  templateId   String
  userId       String
  draft        Json
  appliedAt    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, templateId, userId])
  @@index([workspaceId, userId])
  @@index([templateId])
}

// ============================================================================
// INTEGRATIONS & API KEYS
// ============================================================================

/// Integration — base record for each provider connection per workspace.
///
/// Each provider can only be connected once per workspace (unique constraint).
/// Provider-specific identity data lives in `providerMeta` (small, stable JSON).
/// Boolean settings, channels, and webhooks are in normalized child tables.
model Integration {
  id            String              @id @default(uuid())
  workspaceId   String
  provider      IntegrationProvider
  connected     Boolean             @default(false)
  accessToken   String?             // OAuth token (GitHub/Slack) — encrypted at app level
  providerMeta  Json?               // Small stable identity data (GitHub user, Slack team, etc.)
  connectedAt   DateTime?
  connectedById String?             // FK → User who connected this integration

  // -- Relations --
  workspace   Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectedBy User?                  @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  settings    IntegrationSetting[]
  channels    IntegrationChannel[]
  webhooks    IntegrationWebhook[]

  @@unique([workspaceId, provider])
  @@index([workspaceId])
}

/// IntegrationSetting — key/value boolean settings per integration.
/// Each provider defines its own keys (e.g., GitHub: "autoCompleteOnMerge", Slack: "notifyOnIssueCreatedUrgent").
/// Adding a new setting never requires a migration — just insert a row.
model IntegrationSetting {
  id            String  @id @default(uuid())
  integrationId String
  key           String  // Setting name (e.g., "autoCompleteOnMerge")
  enabled       Boolean @default(true)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, key])
  @@index([integrationId])
}

/// IntegrationChannel — Slack channel mappings for notification routing.
/// Scope determines where this channel is used:
///   "default" — fallback channel (scopeId is null)
///   "project" — project-specific (scopeId = projectId)
///   "team"    — team-specific (scopeId = teamId)
///   "urgent"  — urgent/high priority overlay (scopeId is null)
model IntegrationChannel {
  id            String @id @default(uuid())
  integrationId String
  channelId     String // Slack channel ID (e.g., "C0123456789")
  channelName   String // Display name (e.g., "#engineering")
  scope         String // "default" | "project" | "team" | "urgent"
  scopeId       String? // projectId or teamId (null for default/urgent)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, channelId, scope, scopeId])
  @@index([integrationId, scope])
}

/// IntegrationWebhook — Discord webhook URL mappings for notification routing.
/// Same scope system as IntegrationChannel but stores webhook URLs instead of channel IDs.
/// The webhook URL IS the credential for Discord (no separate token).
model IntegrationWebhook {
  id            String @id @default(uuid())
  integrationId String
  url           String // Discord webhook URL
  label         String // Human-readable name (e.g., "#dev-updates")
  scope         String // "default" | "project" | "team" | "urgent"
  scopeId       String? // projectId or teamId (null for default/urgent)

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, scope, scopeId, url])
  @@index([integrationId, scope])
}

/// ApiKey — workspace API keys for external integrations and MCP server
///
/// Keys are hashed (SHA-256) before storage — the raw key is returned once on creation, never again.
/// `keyPrefix` stores the first 16 chars for display identification (e.g., "lin_live_a8f3bc91").
/// Lookup is by exact keyHash match (unique indexed) — O(1), no scanning.
/// Format: lin_live_* (production), lin_test_* (development).
model ApiKey {
  id          String    @id @default(uuid())
  workspaceId String
  name        String // Human-readable label (e.g., "CI/CD Pipeline")
  keyHash     String    @unique // SHA-256 hash of full key — unique index for O(1) lookup
  keyPrefix   String // First 16 chars for display (e.g., "lin_live_a8f3bc91")
  createdById String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime? // Updated periodically on API requests (debounced)
  expiresAt   DateTime? // Optional expiration — null means never expires

  // -- Relations --
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id])
  aiConnection AiConnection?
  aiConnectionSessions AiConnectionSession[]

  @@index([workspaceId])
}

model AiConnection {
  id          String               @id @default(uuid())
  workspaceId String
  userId      String
  apiKeyId    String?              @unique
  label       String
  client      AiConnectionClient
  authType    AiConnectionAuthType @default(PAT)
  status      AiConnectionStatus   @default(ACTIVE)
  scopes      Json?
  lastUsedAt  DateTime?
  lastVerifiedAt DateTime?
  lastVerificationStatus AiConnectionVerificationStatus?
  lastVerificationMessage String?
  lastVerificationChecks Json?
  rotatedAt   DateTime?
  requestCount Int                 @default(0)
  toolCallCount Int                @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey    ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  sessions  AiConnectionSession[]

  @@index([workspaceId, userId, createdAt])
  @@index([workspaceId, client, status])
}

model AiConnectionSession {
  id            String                   @id @default(uuid())
  aiConnectionId String
  workspaceId   String
  userId        String
  apiKeyId      String?
  client        AiConnectionClient
  sessionKey    String?
  providerSessionId String?
  clientName    String?
  clientVersion String?
  authType      AiConnectionAuthType
  transport     String
  status        AiConnectionSessionStatus @default(ACTIVE)
  scopeSnapshot Json?
  requestCount  Int                      @default(1)
  toolCallCount Int                      @default(0)
  lastErrorCode String?
  lastErrorMessage String?
  startedAt     DateTime                 @default(now())
  lastActivityAt DateTime                @default(now())
  completedAt   DateTime?

  aiConnection AiConnection @relation(fields: [aiConnectionId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey       ApiKey?      @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  steps        AiConnectionSessionStep[]

  @@index([workspaceId, startedAt])
  @@index([aiConnectionId, startedAt])
  @@index([userId, startedAt])
  @@index([status, startedAt])
  @@index([aiConnectionId, sessionKey, status, lastActivityAt])
  @@index([aiConnectionId, transport, client, lastActivityAt])
}

model AiConnectionSessionStep {
  id          String   @id @default(uuid())
  sessionId   String
  toolName    String
  status      String
  errorMessage String?
  startedAt   DateTime @default(now())
  completedAt DateTime?

  session AiConnectionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, startedAt])
}

// ============================================================================
// BILLING & SUBSCRIPTION (Stripe)
// ============================================================================

/// Subscription — workspace billing plan managed via Stripe
///
/// Every workspace starts on FREE plan. Upgrades go through Stripe Checkout.
/// Stripe webhooks update this table (invoice.paid, subscription.updated, etc.).
model Subscription {
  id                   String             @id @default(uuid())
  workspaceId          String
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  billingCycle         BillingCycle       @default(MONTHLY)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false) // If true, cancels at end of period
  seatCount            Int                @default(1)
  storageUsedBytes     BigInt             @default(0) // Cached total storage usage in bytes
  stripeCustomerId     String? // Stripe customer ID
  stripeSubscriptionId String? // Stripe subscription ID
  stripeSubscriptionItemId String? // Stripe subscription item for seat quantity changes
  stripePriceId        String? // Stripe price ID backing the current plan
  stripePaymentIntentId String? // Latest Stripe payment intent tied to subscription billing
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // -- Relations --
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices  Invoice[]

  @@unique([workspaceId])
  @@index([stripeCustomerId])
  @@unique([stripeSubscriptionId])
  @@index([stripePaymentIntentId])
}

/// Invoice — billing invoice records synced from Stripe
///
/// `amount` is stored in cents (e.g., 1200 = $12.00).
/// Invoice numbers are unique within a workspace.
model Invoice {
  id            String        @id @default(uuid())
  workspaceId   String
  subscriptionId String?
  invoiceNumber String // e.g., "INV-001"
  stripeInvoiceId String? @unique
  amount        Int // Amount in cents
  currency      String        @default("usd")
  status        InvoiceStatus @default(UNPAID)
  hostedInvoiceUrl String?
  pdfUrl        String? // Link to downloadable invoice PDF
  issuedAt      DateTime      @default(now())
  paidAt        DateTime? // Set when payment is confirmed

  // -- Relations --
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, invoiceNumber]) // Invoice numbers unique within workspace
  @@index([workspaceId])
  @@index([subscriptionId])
}

/// PaymentMethod — stored payment methods for a workspace (synced from Stripe)
///
/// Only the last 4 digits are stored — full card data lives in Stripe.
model PaymentMethod {
  id                    String            @id @default(uuid())
  workspaceId           String
  type                  PaymentMethodType
  last4                 String // Last 4 digits of card/account
  brand                 String? // e.g., "visa", "mastercard"
  expiryMonth           Int
  expiryYear            Int
  isDefault             Boolean           @default(false) // Primary payment method
  isActive              Boolean           @default(true)
  stripePaymentMethodId String? // Stripe payment method ID
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // -- Relations --
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@unique([stripePaymentMethodId])
}

/// BillingWebhookEvent — persisted Stripe events for idempotency/debugging
model BillingWebhookEvent {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  type          String
  workspaceId   String?
  processed     Boolean  @default(false)
  payload       Json
  createdAt     DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

// ============================================================================
// GOOGLE DRIVE — PER-USER STORAGE INTEGRATION (Phase 19e)
// ============================================================================

/// UserDriveConnection — per-user Google Drive OAuth connection
///
/// Unlike workspace-scoped integrations (GitHub, Slack), Drive is USER-scoped.
/// A user connects their Drive once and can upload from any workspace they belong to.
/// Trussen never stores files — only metadata + Drive links. Zero storage cost.
///
/// Security:
///   - accessToken and refreshToken are encrypted at rest (AES-256-GCM) in the service layer
///   - Tokens are NEVER returned in API responses
///   - `drive.file` scope ensures Trussen can only access files it created
///   - Disconnect revokes the Google token before deleting the record
model UserDriveConnection {
  id             String   @id @default(uuid())
  userId         String   @unique // One Drive connection per user
  provider       String   @default("google_drive") // Future: onedrive, dropbox
  accessToken    String   // Encrypted at rest (AES-256-GCM)
  refreshToken   String   // Encrypted at rest (AES-256-GCM)
  tokenExpiresAt DateTime // When the access token expires (used to trigger refresh)
  email          String   // Google account email for display (e.g., "shaheer@gmail.com")
  connected      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // -- Relations --
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================================================
// TRUSSEN AI — CONVERSATIONS (Phase 20B)
// ============================================================================

/// AiConversation — persistent chat sessions between a user and Trussen AI
///
/// Each conversation belongs to a user + workspace pair.
/// Conversations are resumable — the user can come back to old conversations.
/// Title is auto-generated from the first message or set by the user.
model AiConversation {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  title       String   @default("New conversation")
  summary     String?  @db.Text
  memory      Json?
  summaryMessageCount Int @default(0)
  summaryUpdatedAt DateTime?
  pendingAction Json?
  memoryUpdatedAt DateTime?
  pendingActionUpdatedAt DateTime?
  requestCount Int     @default(0)
  totalInputTokens Int @default(0)
  totalOutputTokens Int @default(0)
  totalTokens Int      @default(0)
  lastModelUsed String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // -- Relations --
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
  toolExecutions AiToolExecution[]

  @@index([userId, workspaceId])
  @@index([updatedAt])
}

/// AiToolExecution — recent AI mutation executions for duplicate protection
///
/// Stores the normalized fingerprint and compact result of a mutation tool call.
/// This prevents repeated tool retries in the same conversation from duplicating work.
model AiToolExecution {
  id             String   @id @default(uuid())
  workspaceId    String
  userId         String
  conversationId String?
  toolName       String
  fingerprint    String
  windowKey      String
  status         String   @default("STARTED")
  result         Json?
  errorMessage   String?
  completedAt    DateTime?
  createdAt      DateTime @default(now())

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, userId, createdAt])
  @@index([conversationId, createdAt])
  @@index([fingerprint, createdAt])
  @@unique([workspaceId, fingerprint, windowKey])
}

/// AiMessage — individual messages in a Trussen AI conversation
///
/// Roles:
///   USER — user's input message
///   ASSISTANT — AI's text response
///   TOOL_CALL — AI decided to call a tool (stored as JSON in toolCalls)
///   TOOL_RESULT — result of tool execution (stored as JSON in toolResults)
///
/// Tool calls and results are stored for conversation history replay
/// and audit trail. The AI sees previous tool calls when continuing a conversation.
model AiMessage {
  id             String        @id @default(uuid())
  conversationId String
  role           AiMessageRole
  content        String        @db.Text // Message text (user input or AI response)
  toolCalls      Json?         // For ASSISTANT: [{tool, args}] when AI invokes tools
  toolResults    Json?         // For TOOL_RESULT: [{tool, result}] execution results
  tokenCount     Int           @default(0) // Token usage for this message
  createdAt      DateTime      @default(now())

  // -- Relations --
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum AiMessageRole {
  USER
  ASSISTANT
  TOOL_CALL
  TOOL_RESULT
}

enum AiSuggestionType {
  ASSIGNEE
  DUPLICATE
  LABEL
  PRIORITY
  STALE_ISSUE
  WEEKLY_DIGEST
  SPRINT_PLANNING
  PROJECT_HEALTH
  TEAM_HEALTH
  CYCLE_HEALTH
}

enum AiSuggestionStatus {
  OPEN
  ACCEPTED
  DISMISSED
  EXPIRED
  SUPERSEDED
}

enum AiSuggestionSource {
  RULE
  EMBEDDING
  AI_MODEL
  SQL
  TEMPLATE
  SYSTEM
}

enum AiEmbeddingEntityType {
  ISSUE
  COMMENT
  DOCUMENT
  PROJECT
  TEAM
  DEPARTMENT
  MEMBER
  CYCLE
}

enum EntityAliasType {
  PROJECT
  TEAM
  DEPARTMENT
  MEMBER
  CYCLE
}

enum AiJobRunStatus {
  STARTED
  SUCCEEDED
  FAILED
  SKIPPED
}

/// AiWorkspaceUsageDaily — daily AI usage totals per workspace
model AiWorkspaceUsageDaily {
  id                  String   @id @default(uuid())
  workspaceId         String
  date                DateTime @db.Date
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  totalTokens         Int      @default(0)
  requestCount        Int      @default(0)
  issueGenerationCount Int     @default(0)
  chatTurnCount       Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
  @@index([workspaceId, date])
}

/// AiUserUsageDaily — daily AI usage totals per workspace user
model AiUserUsageDaily {
  id                  String   @id @default(uuid())
  workspaceId         String
  userId              String
  date                DateTime @db.Date
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  totalTokens         Int      @default(0)
  requestCount        Int      @default(0)
  issueGenerationCount Int     @default(0)
  chatTurnCount       Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, date])
  @@index([workspaceId, date])
  @@index([workspaceId, userId])
  @@index([userId, date])
}

/// AiSuggestion — durable passive-intelligence outputs waiting for user action
model AiSuggestion {
  id              String             @id @default(uuid())
  workspaceId     String
  type            AiSuggestionType
  status          AiSuggestionStatus @default(OPEN)
  source          AiSuggestionSource
  targetType      String
  targetId        String
  title           String
  message         String             @db.Text
  confidence      Float?
  reason          String?            @db.Text
  payload         Json
  dedupeKey       String
  model           String?
  inputTokens     Int                @default(0)
  outputTokens    Int                @default(0)
  createdByUserId String?
  acceptedById    String?
  dismissedById   String?
  acceptedAt      DateTime?
  dismissedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("AiSuggestionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptedBy User?    @relation("AiSuggestionAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  dismissedBy User?   @relation("AiSuggestionDismissedBy", fields: [dismissedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, status, type])
  @@index([workspaceId, targetType, targetId])
  @@index([workspaceId, createdAt])
}

/// AiEmbedding — vector storage for duplicate detection and future semantic search
model AiEmbedding {
  id          String                @id @default(uuid())
  workspaceId String
  entityType  AiEmbeddingEntityType
  entityId    String
  contentHash String
  content     String                @db.Text
  embedding   Unsupported("vector(1536)")
  model       String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, entityType, entityId])
  @@index([workspaceId, entityType])
  @@index([workspaceId, entityId])
}

/// EntityAlias — normalized alternate names used by Trussen AI entity resolution
model EntityAlias {
  id          String          @id @default(uuid())
  workspaceId String
  entityType  EntityAliasType
  entityId    String
  alias       String
  normalized  String
  locale      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType])
  @@index([workspaceId, entityType, normalized])
  @@index([workspaceId, entityType, entityId])
  @@unique([workspaceId, entityType, entityId, normalized])
}

/// AiJobRun — background AI execution health and support tracing
model AiJobRun {
  id           String         @id @default(uuid())
  workspaceId  String?
  jobName      String
  jobId        String?
  status       AiJobRunStatus
  targetType   String?
  targetId     String?
  errorCode    String?
  errorMessage String?        @db.Text
  metadata     Json?
  startedAt    DateTime       @default(now())
  finishedAt   DateTime?

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, jobName, startedAt])
  @@index([jobName, status, startedAt])
}

/// AiResolverSnapshot — persisted entity-resolution audit trail for replay and tuning
model AiResolverSnapshot {
  id                String   @id @default(uuid())
  workspaceId       String
  userId            String?
  conversationId    String?
  triggeringIntent  String?
  requestedEntityType String
  expectedEntityTypes String[]
  rawTextFragment   String   @db.Text
  accessMode        String
  actionRisk        String
  chosenCandidateId String?
  chosenCandidateName String?
  confidence        Float?
  resolutionStatus  String
  confirmationRequired Boolean @default(false)
  contextOnly       Boolean @default(false)
  memoryAssisted    Boolean @default(false)
  topCandidates     Json?
  reason            String?  @db.Text
  metadata          Json?
  createdAt         DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, triggeringIntent, createdAt])
  @@index([workspaceId, requestedEntityType, resolutionStatus, createdAt])
}

/// AiMetricCounterDaily — durable daily counters for AI quality and orchestration metrics
model AiMetricCounterDaily {
  id             String   @id @default(uuid())
  workspaceId    String
  feature        String
  metric         String
  bucketDate     DateTime @db.Date
  dimensionsHash String
  dimensions     Json?
  count          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, feature, metric, bucketDate, dimensionsHash])
  @@index([workspaceId, feature, metric, bucketDate])
}
